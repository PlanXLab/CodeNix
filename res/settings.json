{
  "files.autoSave": "onFocusChange",
  "files.exclude": {
    "**/__pycache__": true,
    "**/.venv": true,
    "**/.temp": true,
    "**/.git": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/.cache/**": true,
    "**/.venv/**": true,
    "**/__pycache__/**": true
  },
  "search.exclude": {
    "**/dist/**": true,
    "**/build/**": true,
    "**/.venv/**": true
  },
  "editor.mouseWheelZoom": true,
  "editor.fontFamily": "'0xProto Nerd Font', 'DalseoHealing'",
  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "boundary",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
  "editor.fontLigatures": true,
  "editor.lineHeight": 1.5,

  "workbench.startupEditor": "none",
  "workbench.tree.indent": 22,
  "workbench.colorTheme": "Ayu Mirage Bordered",
  "workbench.iconTheme": "ayu",
  
  "window.commandCenter": false,
  "security.workspace.trust.startupPrompt": "once",
  
  "terminal.integrated.mouseWheelZoom": true,
  "terminal.integrated.fontSize": 14,
  "terminal.explorerKind": "integrated",
  "terminal.integrated.suggest.enabled": false,
  "terminal.integrated.minimumContrastRatio": 1,

  "terminal.integrated.sendKeybindingsToShell": true,
  "terminal.integrated.commandsToSkipShell": [
    "-workbench.action.quickOpenNavigateNextInRecentFilesPicker",
    "-workbench.action.terminal.findNext"
  ],
  "terminal.integrated.allowChords": false,
  "terminal.integrated.shellIntegration.enabled": false,

  "terminal.integrated.defaultProfile.windows": "PowerShell 7 (portable)",

  "terminal.integrated.profiles.windows": {
    "PowerShell 7 (portable)": {
      "path": "${env:VSCODE_PORTABLE}\\lib\\pwsh\\pwsh.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-NoExit",
        "-Command",
        ". \"$env:VSCODE_PORTABLE\\lib\\pwsh\\Microsoft.PowerShell_profile.ps1\""
      ],
      "icon": "terminal-powershell"
    }
  },

  "python.defaultInterpreterPath": "${workspaceFolder}/.venv",
  "python.useEnvironmentsExtension": true,
  "python-envs.alwaysUseUv": true,
  "python-envs.terminal.autoActivationType": "command",
  "python.analysis.diagnosticSeverityOverrides": {
    "reportMissingModuleSource": "none"
  },
  "python.analysis.exclude": [
    "**/__pycache__",
    "**/.venv",
    "**/.vscode",
    "**/build",
    "**/dist",
    "**/.git"
  ],

  "explorer.confirmDelete": false,
  "explorer.confirmPasteNative": false
}
